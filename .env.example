# ==============================================================================
# Nexora AI Observability Dashboard — Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Note: In Vite applications, only variables prefixed with VITE_ are exposed
# to the client-side bundle. DO NOT put private server credentials here.
# ==============================================================================

# Google Gemini API Key
# Used for AI semantic search, log dialogue analysis, and executive summaries.
# Obtain a key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Default Webhook Endpoint URL (Optional)
# The remote REST API endpoint to poll or fetch log entries from.
# Example: https://api.yourdomain.com/v1/nexora/logs
VITE_DEFAULT_WEBHOOK_URL=

# Default Webhook Authorization Header Token (Optional)
# The Bearer or custom token sent in the Authorization header.
# Example: Bearer your_secure_token_here
VITE_DEFAULT_AUTH_TOKEN=

# Token Cost Calculation (in Toman per token)
# Used to calculate estimated operational costs in the dashboard.
VITE_COST_PER_TOKEN=0.5
